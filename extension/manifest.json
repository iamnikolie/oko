{
  "manifest_version": 3,
  "name": "oko",
  "version": "0.2.0",
  "description": "Lets the oko CLI drive the tabs you hand over, through a bridge on 127.0.0.1. Local only.",
  "minimum_chrome_version": "125",
  "icons": { "128": "icons/oko-128.png" },
  "permissions": ["debugger", "tabs", "storage", "alarms", "tabGroups"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "oko",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png" }
  }
}
